{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": true,
  "bracketSpacing": true,
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": ["node_modules/**", ".vscode/**", "**/*.js.snap", "/test/conf/*.js"]
}
